! X colors.
! Generated by 'wal'
*foreground:        #ddd1bc
*background:        #181915
*.foreground:       #ddd1bc
*.background:       #181915
emacs*foreground:   #ddd1bc
emacs*background:   #181915
URxvt*foreground:   #ddd1bc
XTerm*foreground:   #ddd1bc
UXTerm*foreground:  #ddd1bc
URxvt*background:   [100]#181915
XTerm*background:   #181915
UXTerm*background:  #181915
URxvt*cursorColor:  #ddd1bc
XTerm*cursorColor:  #ddd1bc
UXTerm*cursorColor: #ddd1bc
URxvt*borderColor:  [100]#181915

! Colors 0-15.
*.color0: #181915
*color0:  #181915
*.color1: #50B448
*color1:  #50B448
*.color2: #668B75
*color2:  #668B75
*.color3: #A99068
*color3:  #A99068
*.color4: #E8AE53
*color4:  #E8AE53
*.color5: #D5A96D
*color5:  #D5A96D
*.color6: #669787
*color6:  #669787
*.color7: #ddd1bc
*color7:  #ddd1bc
*.color8: #9a9283
*color8:  #9a9283
*.color9: #50B448
*color9:  #50B448
*.color10: #668B75
*color10:  #668B75
*.color11: #A99068
*color11:  #A99068
*.color12: #E8AE53
*color12:  #E8AE53
*.color13: #D5A96D
*color13:  #D5A96D
*.color14: #669787
*color14:  #669787
*.color15: #ddd1bc
*color15:  #ddd1bc

! Black color that will not be affected by bold highlighting.
*.color66: #181915
*color66:  #181915

! Xclock colors.
XClock*foreground: #ddd1bc
XClock*background: #181915
XClock*majorColor:  rgba:dd/d1/bc/ff
XClock*minorColor:  rgba:dd/d1/bc/ff
XClock*hourColor:   rgba:dd/d1/bc/ff
XClock*minuteColor: rgba:dd/d1/bc/ff
XClock*secondColor: rgba:dd/d1/bc/ff

! Set depth to make transparency work.
URxvt*depth: 32
